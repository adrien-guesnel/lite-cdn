    "nest-winston": "2.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "winston": "3.19.0",
    "winston-loki": "6.1.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@nestjs/cli": "12.0.11",
